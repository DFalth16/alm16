# Variables de entorno para el Sistema de Gestión de Taller

# Supabase Configuration
# Obtén estos valores desde tu proyecto en Supabase:
# https://app.supabase.com → Tu Proyecto → Settings → API

REACT_APP_SUPABASE_URL=https://tu-proyecto.supabase.co
REACT_APP_SUPABASE_ANON_KEY=tu-anon-key-aqui

# Ejemplo:
# REACT_APP_SUPABASE_URL=https://xyzcompany.supabase.co
# REACT_APP_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
